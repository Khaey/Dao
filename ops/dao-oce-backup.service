[Unit]
Description=Bounded OCE cold backup and isolated PostgreSQL restore
After=docker.service
Requires=docker.service

[Service]
Type=exec
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/dao-oce-backup worker
ExecStopPost=/usr/local/sbin/dao-oce-backup recover
RuntimeMaxSec=10min
TimeoutStopSec=5min
KillMode=control-group
Restart=no
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

# Intentionally not enabled at boot and not scheduled.
