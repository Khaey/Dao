[Unit]
Description=D.A.O private OCE gateway
After=network-online.target systemd-tmpfiles-setup.service dao-oce-egress-guard.service
Requires=dao-oce-egress-guard.service

[Service]
Type=simple
User=dao-oce-gateway
Group=dao-oce-gateway
SupplementaryGroups=dao
ExecStart=/usr/local/libexec/dao-oce-gateway serve
LoadCredential=oce-gateway:/etc/dao-oce/private/gateway-credential.json
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET
RuntimeDirectory=dao-oce-gateway
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/dao-oce-gateway /run/dao-oce-gateway
ReadOnlyPaths=/etc/dao-oce/private/gateway-credential.json

[Install]
WantedBy=multi-user.target
